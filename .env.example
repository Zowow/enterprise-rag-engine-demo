# ==============================================================================
# Enterprise Knowledge RAG Engine - Local Development Environment Variables
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env containing actual secrets to version control.
# ==============================================================================

# Project Name Prefix
PROJECT_NAME=enterprise-rag

# PostgreSQL Database Configuration
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=enterprise_rag_dev
POSTGRES_PORT=5432

# Redis Cache & Rate Limiting
REDIS_PORT=6379

# Qdrant Vector Database
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# Azurite (Azure Storage Emulator)
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

# Backend Web API (.NET 9)
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# Frontend Client (React / Vite)
FRONTEND_PORT=3000

# AI Provider API Keys
# Required for Semantic Kernel / OpenAI embeddings and synthesis in later milestones
OPENAI_API_KEY=
